# Supabase Configuration Templates (Replace with actual values in .env)
SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key"
SUPABASE_URL="https://your-supabase-project-id.supabase.co"
VITE_SUPABASE_PROJECT_ID="your-supabase-project-id"
VITE_SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key"
VITE_SUPABASE_URL="https://your-supabase-project-id.supabase.co"

# Demo mode: set to "true" to serve the bundled mock dataset instead of
# Supabase (also activates automatically when the credentials above are unset).
VITE_DEMO_MODE="false"

# Basemap. The default is Esri's keyless dark canvas. Override these for a
# keyed provider such as MapTiler; nginx deployments must also allow its tile
# host in infra/default.conf's Content-Security-Policy.
VITE_MAP_TILE_URL="https://services.arcgisonline.com/ArcGIS/rest/services/Canvas/World_Dark_Gray_Base/MapServer/tile/{z}/{y}/{x}"
VITE_MAP_TILE_ATTRIBUTION="&copy; Esri, HERE, Garmin, &copy; OpenStreetMap contributors"
VITE_MAP_TILE_MAX_NATIVE_ZOOM="16"

# Optional Docker scheduler integration. The hosted Supabase deployment uses
# pg_cron + Vault instead and does not need INGEST_TOKEN in .env.
INGEST_URL="https://your-supabase-project-id.supabase.co/functions/v1/ingest-don-feed"
HEALTHCHECK_URL="https://your-supabase-project-id.supabase.co/functions/v1/infra-health-check"
INGEST_TOKEN=""

# Docker scheduler intervals (only used with `--profile scheduler`; pg_cron is
# the default scheduler — don't run both or ingest runs will be duplicated)
INGEST_INTERVAL_SECONDS="43200"
HEALTHCHECK_INTERVAL_SECONDS="300"

# Edge Function secrets (set via `supabase secrets set`, not just .env):
#   FIRECRAWL_API_KEY   – Firecrawl bearer token for ingest-don-feed
# Scheduler bearer credentials are generated into Supabase Vault by the
# harden_scheduler_and_public_projection migration.

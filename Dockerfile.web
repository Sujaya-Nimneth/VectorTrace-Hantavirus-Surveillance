# ---- Build stage: full toolchain + source ----
FROM node:22.23-alpine AS build
WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY . .
RUN npm run build

# ---- Runtime stage: build output + toolchain only, no source ----
# Note: `vite preview` is the self-host dev server; it needs vite + workerd
# from node_modules. Production serving runs on Cloudflare Workers (see
# .github/workflows/deploy.yml) — the Docker path exists for local parity.
FROM node:22.23-alpine
WORKDIR /app
ENV NODE_ENV=production

COPY package*.json ./
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/dist ./dist

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD wget -qO- http://127.0.0.1:8080/ >/dev/null || exit 1

USER node

CMD ["npm", "run", "preview", "--", "--host", "0.0.0.0", "--port", "8080"]
